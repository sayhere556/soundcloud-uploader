# Copy these values into your Codespace secrets or your private .env file.
# Never commit .env or account tokens. Do not paste secrets into chat.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Register this exact callback on your SoundCloud application.
SCM_REDIRECT_URI=http://127.0.0.1:8085/auth/callback
SCM_PUBLIC_URL=http://127.0.0.1:8085
