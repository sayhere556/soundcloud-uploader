# From https://soundcloud.com/you/apps after registering your app
SOUNDCLOUD_CLIENT_ID=your_client_id
SOUNDCLOUD_CLIENT_SECRET=your_client_secret

# Must match the Redirect URI in your SoundCloud app settings exactly
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:8765/callback

# Where OAuth tokens are stored after login (default shown)
# SOUNDCLOUD_TOKEN_FILE=~/.soundcloud-mcp/tokens.json
